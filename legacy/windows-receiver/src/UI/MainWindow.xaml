<Window x:Class="Dtcon.Receiver.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DTCON Receiver"
        Width="460" Height="320"
        WindowStyle="ToolWindow"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">

    <Grid Margin="14" RowDefinitions="Auto,Auto,Auto,*">
        <!-- Status -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,10">
            <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,4,8,0"
                     VerticalAlignment="Top" Fill="#808080"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" FontSize="14"
                           Text="Scanning…" VerticalAlignment="Center"/>
                <TextBlock x:Name="DeviceText" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="#6B7280" Text=""/>
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="ReconnectButton" Content="Reconnect" Padding="10,4" Click="OnReconnect"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Padding="10,4" Margin="8,0,0,0" Click="OnDisconnect"/>
            <Button Content="Clear log" Padding="10,4" Margin="8,0,0,0" Click="OnClearLog"/>
            <Button Content="Hide to tray" Padding="10,4" Margin="8,0,0,0" Click="OnHide"/>
        </StackPanel>

        <!-- Log -->
        <TextBlock Grid.Row="2" Text="Log" Foreground="#9CA3AF" FontSize="11" Margin="0,0,0,4"/>
        <ListBox x:Name="LogList" Grid.Row="3" FontSize="11" Foreground="#374151"
                 FontFamily="Consolas" VerticalContentAlignment="Top"/>
    </Grid>
</Window>